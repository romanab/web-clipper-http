{
  "name": "web-clipper-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:upstream": "node scripts/check-upstream.mjs",
    "update:upstream": "node scripts/update-upstream.mjs",
    "build:upstream": "npm run check:upstream && npm --prefix upstream/obsidian-clipper run build:api",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "verify": "npm run build:upstream && npm run typecheck && npm test",
    "build": "npm run verify && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "release:check": "npm run package"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "@types/jsdom": "^21.1.7",
    "esbuild": "^0.28.1",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
